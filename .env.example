# AI provider (server-only)
AI_PROVIDER=auto
# Select AI_PROVIDER=openrouter explicitly to use these settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=qwen/qwen3.8-max-free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Token-saving assessment controls. Keep the default values unless you need to tune quotas.
AI_MAX_INPUT_TOKENS=6000
AI_MAX_OUTPUT_TOKENS=2200
AI_TOP_K_PER_RUBRIC=2
AI_CHUNK_TOKENS=600
AI_CHUNK_OVERLAP_TOKENS=60
AI_DAILY_LIMIT_PER_REVIEWER=5

# Local development can omit both values and use .data/skillbridge.db.
# Vercel must receive these from the Turso Marketplace integration.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Private Blob uses short-lived OIDC credentials for server-side reads/writes.
# Client uploads for files above 4 MB additionally require BLOB_READ_WRITE_TOKEN,
# because @vercel/blob/client uses a signed read-write upload token.
BLOB_STORE_ID=
# Optional client-upload credential (also works as a server-side alternative).
BLOB_READ_WRITE_TOKEN=

# Solana Devnet server signers. Use JSON byte arrays or base58-encoded 64-byte keypairs.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_FEE_PAYER_SECRET=
# Optional sponsored reward claims (Devnet). Use a separate funded sponsor keypair.
SPONSORED_CLAIMS_ENABLED=false
SOLANA_SPONSOR_SECRET=
# Maximum reserved daily budget: 0.1 SOL; per claim: 0.003 SOL including USDC account rent.
SPONSOR_DAILY_LAMPORTS=100000000
SPONSOR_MAX_CLAIM_LAMPORTS=3000000
SOLANA_ISSUER_SECRET=
# Optional public issuer authorities for wallet badge lookup, comma-separated.
# If blank, the verifier build derives ONLY the public address from SOLANA_ISSUER_SECRET.
# Include historical issuer authorities here after key rotation.
SKILLBRIDGE_TRUSTED_ISSUERS=
SOLANA_AUTHORIZED_SIGNER_SECRET=
# Dedicated Devnet vault used only for challenge funding, payouts and refunds.
# During a local demo this may temporarily be the same key as SOLANA_AUTHORIZED_SIGNER_SECRET,
# but production must use a separate, funded keypair.
SOLANA_REWARD_VAULT_SECRET=
CHALLENGE_BADGE_BOND_SOL=0.05
# Devnet off-ramp lab. The USDC transfer is real on Devnet; the VND bank leg is
# an explicit sandbox until a licensed provider is integrated.
CASHOUT_SANDBOX_VND_RATE=25000
CASHOUT_PROVIDER_FEE_BPS=80
CASHOUT_NETWORK_FEE_VND=5000
CASHOUT_QUOTE_TTL_SECONDS=60
# Market-reference sources. CoinGecko and the public ExchangeRate-API fallback
# work without keys; the optional keys add independent or higher-SLA sources.
# A reference rate is never a committed VND payout quote.
FX_CACHE_TTL_SECONDS=20
FX_MAX_STALENESS_SECONDS=300
FX_MAX_DEVIATION_BPS=100
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_HERMES_API_KEY=
PYTH_USDC_USD_FEED_ID=eaa020c61cc479712813461ce153894a96a6c00b21ed0cfc2798d1f9a9e9c94a
EXCHANGE_RATE_API_KEY=
OPEN_EXCHANGE_RATES_APP_ID=
# Required for NEW cashout quotes: dedicated public Devnet address, separate from
# challenge reward vault. No fallback. Old orders retain their saved address/mint.
# Never place a private key here; this application does not need its signing key.
CASHOUT_DEVNET_SETTLEMENT_WALLET=
# Optional server-only sandbox webhook v2 HMAC secret (timestamp + event id + body).
# Legacy sha256=body-only callbacks are rejected; see docs/testing/offramp.md.
CASHOUT_WEBHOOK_SECRET=

# Multi-rail VND receiving architecture. Leave the safe defaults in place for
# the current Devnet lab: provider keys alone never activate a real conversion.
CASHOUT_MODE=devnet_sandbox
REAL_CASHOUT_ENABLED=false
OFFRAMP_PROVIDER=devnet_sandbox
# Leave these empty. Configuring an unimplemented production provider fails closed.
OFFRAMP_API_BASE_URL=
OFFRAMP_API_KEY=
PAYOUT_PROVIDERS=payos,momo,zalopay

# Payout provider credentials are server-only. Add them only after the provider
# has approved the relevant product (chi hộ/disbursement), then keep real VND
# transfers disabled until the licensed USDC-to-VND off-ramp adapter is certified.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PUBLIC_KEY=
MOMO_STORE_ID=
ZALOPAY_APP_ID=
ZALOPAY_MAC_KEY=
ZALOPAY_PRIVATE_KEY=
ZALOPAY_MERCHANT_WALLET_ID=

# Optional fallback provider; TokenRouter takes priority when both are present.
OPENAI_API_KEY=
OPENAI_ASSESSMENT_MODEL=
